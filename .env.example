# Server Configuration
PORT=3000
NODE_ENV=production

# Security & Admin Secrets (Generate with: openssl rand -hex 32)
ADMIN_SECRET_KEY=replace_with_32_byte_hex_string
CRON_SECRET=replace_with_32_byte_hex_string
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_string

# Ring Developer Credentials (from developer.ring.com)
RING_CLIENT_ID=your_ring_client_id
RING_CLIENT_SECRET=your_ring_client_secret
RING_HMAC_KEY=your_ring_hmac_signing_key
RING_OAUTH_URL=https://oauth.ring.com/oauth/token
RING_API_BASE=https://api.ring.com

# Supabase — Database + Storage (from supabase.com project settings)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# Firebase Cloud Messaging (push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OpenRouter AI (Get from: https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_key

# Optional AI & Debounce Tuning
# AI_MODEL_TIER_1=google/gemini-2.0-flash-exp:free,meta-llama/llama-3.2-11b-vision-instruct:free,qwen/qwen-2.5-vl-72b-instruct:free
# AI_MODEL_TIER_2=google/gemini-2.0-flash-001,openai/gpt-4o-mini
# AI_MODEL_TIER_3=openai/gpt-4o
# AI_CONFIDENCE_THRESHOLD=0.6
# MOTION_DEBOUNCE_SECONDS=30
